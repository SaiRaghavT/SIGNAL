DB_HOST=localhost
DB_PORT=5432
DB_NAME=signal
DB_USER=postgres
DB_PASSWORD=your_database_password

GEMINI_ENABLED=false
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=
# Optional dedicated credentials; these override GROQ_API_KEY for their flow.
GROQ_RUN_DETECTION_API_KEY=
GROQ_ANATOMY_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
ANATOMY_AI_MAX_CONCURRENCY=2
EVIDENCE_STRENGTH_STRUCTURED_BASE=60
EVIDENCE_STRENGTH_DOCUMENT_BASE=50
EVIDENCE_STRENGTH_MULTIPLE_SYMPTOMS_BASE=40
EVIDENCE_STRENGTH_EXPOSURE_BASE=35
EVIDENCE_STRENGTH_SINGLE_SYMPTOM_BASE=25
EVIDENCE_STRENGTH_QUOTE_BONUS=10
EVIDENCE_STRENGTH_ADDITIONAL_SOURCE_BONUS=5
EVIDENCE_STRENGTH_MAX_SOURCE_BONUS=15
EVIDENCE_STRENGTH_CROSS_SOURCE_BONUS=5
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b
TESSERACT_CMD=

# Synthetic measles demo queueing is tagged and blocked from external dispatch.
DEMO_QUEUE_ENABLED=true
